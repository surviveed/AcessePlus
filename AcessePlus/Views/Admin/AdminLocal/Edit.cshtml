@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cadastro de Locais";
}

<div class="home-page home-page--full-gradient">
    <div class="home-main-content" style="max-width: 600px;">
        <div class="login-wrapper">
            <h2 class="login-title">Cadastrar Novo Local</h2>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="input-group">
                    <label for="Nome">Nome</label>
                    <input type="text" id="Nome" name="Nome" value="@Model.Nome" required />
                </div>

                <div class="input-group">
                    <div id="previewContainer"></div>
                    <label>Fotos do Local</label>
                    <input type="file" id="Imagens" name="Imagens" accept="image/*" multiple style="display:none;" />
                    <button type="button" class="btn" id="btnSelecionarImagem">Adicionar Foto</button>
                </div>

                <div class="input-group">
                    <label for="Capacidade">Capacidade</label>
                    <input type="number" id="Capacidade" name="Capacidade" value="@Model.Capacidade" min="1" />
                </div>

                <div class="input-group">
                    <label for="Endereco">Endereço</label>
                    <input type="text" id="Endereco" name="Endereco" value="@Model.Endereco" required />
                </div>

                <div class="input-group">
                    <label for="tipoSelect">Tipo de Local</label>
                    <select id="tipoSelect" name="TipoLocalId" class="input" required>
                        <option value="">Selecione o Tipo de Local</option>
                        @foreach (var tipo in (List<AcessePlus.Modelo.TipoLocal>)ViewBag.Tipos)
                        {
                            if (Model?.TipoLocalId == tipo.Id)
                            {
                                <option value="@tipo.Id" selected>@tipo.Descricao</option>
                            }
                            else
                            {
                                <option value="@tipo.Id">@tipo.Descricao</option>
                            }
                        }
                    </select>
                </div>


                <div class="input-group">
                    <label for="paisSelect">País</label>
                    <select id="paisSelect" name="PaisId" class="input" required>
                        <option value="">Selecione o país</option>

                        @{
                            var teste = ViewBag.Paises;
                        }

                        @foreach (var pais in ViewBag.Paises)
                        {
                            if (Model?.PaisId == pais.Id)
                            {
                                <option value="@pais.Id" selected>@pais.Descricao</option>
                            }
                            else
                            {
                                <option value="@pais.Id">@pais.Descricao</option>
                            }
                        }
                    </select>
                </div>

                <div class="input-group">
                    <label for="ufSelect">Estado</label>
                    <select id="ufSelect" name="UfId" class="input" required>
                        <option value="">Selecione o estado</option>
                        @foreach (var uf in (List<AcessePlus.Modelo.Uf>)(ViewBag.Ufs ?? new
                                                List<AcessePlus.Modelo.Uf>()))
                        {
                            if (Model?.UfId == uf.Id)
                            {
                                <option value="@uf.Id" selected>@uf.Descricao</option>
                            }
                            else
                            {
                                <option value="@uf.Id">@uf.Descricao</option>
                            }
                        }
                    </select>
                </div>

                <div class="input-group">
                    <label for="cidadeSelect">Cidade</label>
                    <select id="cidadeSelect" name="CidadeId" class="input" required>
                        <option value="">Selecione a cidade</option>
                        @foreach (var cidade in (List<AcessePlus.Modelo.Cidade>)(ViewBag.Cidades ?? new
                                                List<AcessePlus.Modelo.Cidade>()))
                        {
                            if (Model?.CidadeId == cidade.Id)
                            {
                                <option value="@cidade.Id" selected>@cidade.Descricao</option>
                            }
                            else
                            {
                                <option value="@cidade.Id">@cidade.Descricao</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="btn-submit">Salvar</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const paisSelect = document.getElementById('paisSelect');
            const ufSelect = document.getElementById('ufSelect');
            const cidadeSelect = document.getElementById('cidadeSelect');

            const selectedPaisId = '@(Model?.PaisId?.ToString() ?? "")';
            const selectedUfId = '@(Model?.UfId?.ToString() ?? "")';
            const selectedCidadeId = '@(Model?.CidadeId?.ToString() ?? "")';

            function carregarUfs(paisId, selecionarUfId = "") {
                ufSelect.innerHTML = '<option value="">Carregando estados...</option>';
                cidadeSelect.innerHTML = '<option value="">Selecione a cidade</option>';
                ufSelect.disabled = true;
                cidadeSelect.disabled = true;

                if (!paisId) {
                    ufSelect.innerHTML = '<option value="">Selecione o estado</option>';
                    ufSelect.disabled = true;
                    return;
                }

                fetch(`/gerenciador/adm-locais/buscar-ufs-por-pais/${paisId}`)
                    .then(res => res.json())
                    .then(ufs => {
                        ufSelect.innerHTML = '<option value="">Selecione o estado</option>';
                        ufs.forEach(uf => {
                            const option = document.createElement('option');
                            option.value = uf.id;
                            option.textContent = uf.descricao;
                            ufSelect.appendChild(option);
                        });

                        ufSelect.disabled = false;

                        if (selecionarUfId) {
                            ufSelect.value = selecionarUfId;
                            carregarCidades(selecionarUfId, selectedCidadeId);
                        }
                    });
            }

            function carregarCidades(ufId, selecionarCidadeId = "") {
                cidadeSelect.innerHTML = '<option value="">Carregando cidades...</option>';
                cidadeSelect.disabled = true;

                if (!ufId) {
                    cidadeSelect.innerHTML = '<option value="">Selecione a cidade</option>';
                    cidadeSelect.disabled = true;
                    return;
                }

                fetch(`/gerenciador/adm-locais/BuscarCidadesPorUf/${ufId}`)
                    .then(res => res.json())
                    .then(cidades => {
                        cidadeSelect.innerHTML = '<option value="">Selecione a cidade</option>';
                        cidades.forEach(cidade => {
                            const option = document.createElement('option');
                            option.value = cidade.id;
                            option.textContent = cidade.descricao;
                            cidadeSelect.appendChild(option);
                        });

                        cidadeSelect.disabled = false;

                        if (selecionarCidadeId) {
                            cidadeSelect.value = selecionarCidadeId;
                        }
                    });
            }

            if (selectedPaisId) {
                carregarUfs(selectedPaisId, selectedUfId);
            } else {
                ufSelect.disabled = true;
                cidadeSelect.disabled = true;
            }

            paisSelect.addEventListener('change', function () {
                carregarUfs(this.value);
            });

            ufSelect.addEventListener('change', function () {
                carregarCidades(this.value);
            });

            const inputImagens = document.getElementById('Imagens');
            const btnSelecionarImagens = document.getElementById('btnSelecionarImagem');
            const previewContainer = document.getElementById('previewContainer');

            btnSelecionarImagens.addEventListener('click', () => {
                inputImagens.click();
            });

            inputImagens.addEventListener('change', () => {
                previewContainer.innerHTML = '';

                if (inputImagens.files) {
                    Array.from(inputImagens.files).forEach(file => {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.classList.add('preview-imagem');
                            previewContainer.appendChild(img);
                        };
                        reader.readAsDataURL(file);
                    });
                }
            });
        });

        document.querySelector('form').addEventListener('submit', function (event) {
            const inputImagens = document.getElementById('Imagens');
            if (!inputImagens.files || inputImagens.files.length === 0) {
                event.preventDefault();
                Swal.fire({
                    icon: 'error',
                    title: 'Erro',
                    text: 'Por favor, selecione pelo menos uma foto para o local.'
                });
                return false;
            }

            const capacidade = document.getElementById('Capacidade').value;
            if (capacidade <= 0) {
                event.preventDefault();
                Swal.fire({
                    icon: 'error',
                    title: 'Erro',
                    text: 'A capacidade deve ser maior que zero.'
                });
                return false;
            }
        });
    </script>

    @if (TempData["Sucesso"] != null && (bool)TempData["Sucesso"])
    {
        <script>
            window.addEventListener('DOMContentLoaded', function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Local cadastrado com sucesso!',
                    confirmButtonText: 'OK'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/gerenciador/adm-locais';
                    }
                });
            });
        </script>
    }
}
