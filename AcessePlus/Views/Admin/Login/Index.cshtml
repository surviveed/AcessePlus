@{
    Layout = "~/Views/Admin/Shared/_LoginLayout.cshtml";
}

<div class="login-wrapper">
    <h1 class="login-title">Login</h1>

    <form asp-action="Index" method="post">

        <div class="input-group">
            <label for="email">E-mail</label>
            <input id="email" type="email" name="email" placeholder="seu@email.com" required />
        </div>

        <div class="input-group">
            <label for="senha">Senha</label>
            <input id="senha" type="password" name="senha" placeholder="••••••••" required />
        </div>

        <button class="btn-submit" type="submit">Entrar</button>

    </form>

    <p class="register-text">
        Ainda não tem conta?
        <a asp-action="Register"><strong>Cadastre-se</strong></a>
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            alert('@Html.Raw(TempData["ErrorMessage"])');
        </script>
    }
</div>