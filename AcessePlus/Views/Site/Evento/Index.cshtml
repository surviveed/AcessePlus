@{
    Layout = "_Layout";
    ViewData["Title"] = "Eventos";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/site/css/pages/local.css" />
}

@section Scripts {
    <script src="~/site/js/pages/local.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Sucesso"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Avaliação enviada com sucesso!',
                showConfirmButton: false,
                timer: 2000
            });
        </script>
    }
}

<div class="local-page">

    <aside class="search-menu">
        <h2 class="search-menu__title">Filtros de Busca</h2>

        <form asp-action="Index" method="get" class="search-form" id="search-form">

            @* <div class="form-group">
                <label asp-for="Nome" class="form-label">Nome do Local</label>
                <input asp-for="Nome" class="form-control" placeholder="Digite o nome..." />
            </div>

            <div class="form-group">
                <label asp-for="TipoLocalId" class="form-label">Tipo de Local</label>
                <select asp-for="TipoLocalId" asp-items="Model.TiposDeLocal" class="form-control">
                    <option value="">Todos os tipos</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Capacidade" class="form-label">Capacidade Mínima</label>
                <input asp-for="Capacidade" type="number" min="0" class="form-control" placeholder="Ex: 50" />
            </div> *@

        </form>

        <div class="menu-actions">
            <button type="submit" form="search-form" class="btn btn-primary">Buscar</button>
            <a class="btn btn-secondary" asp-action="Create">Adicionar novo local</a>
        </div>
    </aside>

    <div class="main-content-area">

        <h1 class="local-title">Encontre o Local Ideal</h1>

        <main class="local-results">
            @* @if (Model.Resultados.Any())
            {
                <div class="cards-container">
                    @foreach (var local in Model.Resultados)
                    {
                        <div class="local-card" tabindex="0" role="button" aria-label="Local @local.Nome">
                            <img src="@local.ImagemUrl" alt="Imagem do local @local.Nome" />
                            <div class="local-card-content">
                                <h3>@local.Nome</h3>
                                <p>@local.Endereco - @local.Cidade/@local.Uf</p>
                                <p>Capacidade: @local.Capacidade</p>

                                <div class="avaliacoes-container">
                                    <div class="avaliacao-item positiva">
                                        <i class="fas fa-thumbs-up"></i><span>@local.QtdAvaliacoesPositivas</span>
                                    </div>
                                    <div class="avaliacao-item negativa">
                                        <i class="fas fa-thumbs-down"></i><span>@local.QtdAvaliacoesNegativas</span>
                                    </div>
                                </div>

                                <button type="button"
                                        class="btn-avaliar"
                                        onclick="abrirModal('@local.Nome','@local.Id')"
                                @(local.JaAvaliado ? "disabled" : "")>
                                    Avaliar
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-results">
                    <h3>Nenhum local encontrado</h3>
                    <p>Tente ajustar os filtros da sua busca.</p>
                </div>
            } *@
        </main>


        <!-- Modal -->
        <div id="avaliarModal" class="modal" style="display: none;">
            <div class="modal-content">
                <span class="close" onclick="fecharModal()">&times;</span>
                <h2 class="login-title">Avaliação de <span id="nomeLocalSpan"></span></h2>

                <form asp-action="Avaliar" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="LocalId" name="LocalId" />

                    <div class="input-group">
                        <label for="comentario">Comentário</label>
                        <textarea id="comentario" name="comentario" maxlength="2000" rows="5"
                            style="width: 100%;"></textarea>
                        <small id="contadorComentario">0 / 2000</small>
                    </div>

                    <div class="input-group">
                        <label for="tipoAcessibilidade">Tipo de Acessibilidade</label>
                        <select id="tipoAcessibilidade" name="tipoAcessibilidade" class="input" required>
                            <option value="">Selecione</option>
                            <option value="A">Auditiva</option>
                            <option value="V">Visual</option>
                            <option value="L">Locomoção</option>
                            <option value="S">Sensorial</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="tipo">Tipo</label>
                        <select id="tipo" name="tipo" class="input" required>
                            <option value="">Selecione</option>
                            <option value="P">Positiva</option>
                            <option value="N">Negativa</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-submit">Enviar</button>
                </form>
            </div>
        </div>


    </div>
</div>