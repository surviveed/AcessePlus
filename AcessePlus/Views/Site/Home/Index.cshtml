@model AcessePlus.Models.ViewModels.HomeViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

<div class="home-page">
    <div class="home-intro-banner">
        <div class="text">
            <h1 class="text--70 text--fw800 text--black mb-2">Descubra espaços que conectam você ao mundo</h1>
            <p class="text--20 text--gray mb-2">Descubra locais acessíveis com informações confiáveis e atualizadas,
                avalie e compartilhe suas experiências, e contribua para uma comunidade mais inclusiva. Participe também
                de eventos que promovem a acessibilidade e a inclusão social.</p>
            <a href="/locais" class="btn">Conhecer locais</a>
        </div>
        <div class="image">
            <img src="/images/logo-big.png" alt="Logo Acesse+" />
        </div>
    </div>

    <div class="home-main-content">
        <p class="highlight-paragraph text--white">Confira alguns locais cadastrados no Acesse+</p>
        <div class="home-banner swiper">
            <div class="swiper-wrapper">
                @foreach (var local in Model.Locais)
                {
                    <div class="swiper-slide">
                        <img src="@local.ImagemUrl" alt="Foto do local @local.Nome" />
                        <div class="swiper-slide-info">
                            <h3 class="text text--white text--fw700">@local.Nome</h3>
                            <p class="text text--white text--16">@local.Endereco</p>
                            <p class="text text--white text--15">@local.TipoLocal?.Descricao</p>
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>

    <div id="quem-somos" class="quem-somos">
        <div class="card">
            <div class="content">
                <h2 class="text--30 text--fw700 mb-2">Quem somos nós</h2>
                <p class="text mb-2">
                    O <strong>Acesse+</strong> é um aplicativo colaborativo focado em acessibilidade, permitindo que
                    usuários mapeiem, avaliem e compartilhem informações sobre locais públicos acessíveis. Seu objetivo
                    é
                    facilitar a vida de pessoas com deficiência, oferecendo um banco de dados atualizado sobre
                    estabelecimentos com rampas, banheiros adaptados e sinalização para deficientes visuais.<br><br>
                    Os usuários podem cadastrar novos locais, adicionar fotos, avaliar a acessibilidade e deixar
                    comentários
                    com sugestões e experiências. Além disso, é possível gerenciar e participar de eventos relacionados
                    à
                    acessibilidade, promovendo a inclusão social e a melhoria das condições de acessibilidade.<br><br>
                    A aplicação foi desenvolvida por
                    <strong><a href="https://github.com/gabrielaPLMPRO" target="_blank"
                            rel="noopener noreferrer">Gabriela</a></strong>,
                    <strong><a href="https://github.com/surviveed" target="_blank"
                            rel="noopener noreferrer">Francisco</a></strong> e
                    <strong><a href="https://github.com/leonardobls" target="_blank"
                            rel="noopener noreferrer">Leonardo</a></strong>
                    com o propósito de incentivar a colaboração da comunidade e tornar as cidades mais acessíveis e
                    igualitárias.
                </p>
            </div>
            <div class="images">
                <img src="/images/leo.jpg" alt="Logo Acesse+" />
                <img src="/images/gabriela.jpg" alt="Logo Acesse+" />
                <img src="/images/francisco.jpg" alt="Logo Acesse+" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const swiper = new Swiper('.swiper', {
            loop: true,
            effect: 'coverflow',
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: 5,
            spaceBetween: 0,

            autoplay: {
                delay: 4000,
                disableOnInteraction: false,
            },

            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 100,
                modifier: 2.5,
                slideShadows: true,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },

            breakpoints: {
                320: {
                    slidesPerView: 1,
                    spaceBetween: 10,
                },
                640: {
                    slidesPerView: 2,
                    spaceBetween: 20,
                },
                992: {
                    slidesPerView: 3,
                    spaceBetween: 0,
                }
            },
            on: {
                init: function () { },
                slideChange: function () { }
            }
        });
    </script>
}