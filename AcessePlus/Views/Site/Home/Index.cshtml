@model AcessePlus.Models.ViewModels.HomeViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

<div class="home-page home-page--full-gradient">

    <div class="home-main-content">
        <p class="main-subtitle text--white">Sua jornada pela acessibilidade começa aqui.</p>

        <p class="main-subtitle text--white">Confira alguns dos locais já cadastrados no Acesse+</p>

        <div class="home-banner swiper">

            <div class="swiper-wrapper">
                @foreach (var local in Model.Locais)
                {
                    <div class="swiper-slide">
                        <img src="/images/banner@(local.Id).jpg" alt="Foto do local @local.Nome" />
                        <div class="swiper-slide-info">
                            <h3 class="text text--white text--fw700">@local.Nome</h3>
                            <p class="text text--white text--16">@local.Endereco</p>
                            <p class="text text--white text--15">@local.Observacoes</p>
                        </div>
                    </div>
                }
            </div>
            <div class="swiper-pagination"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const swiper = new Swiper('.swiper', {
            loop: true,
            effect: 'coverflow',
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: 5,
            spaceBetween: 0,

            autoplay: {
                delay: 4000,
                disableOnInteraction: false,
            },

            coverflowEffect: {
                rotate: 0,
                stretch: 0,
                depth: 100,
                modifier: 2.5,
                slideShadows: true,
            },
            pagination: {
                el: '.swiper-pagination',
                clickable: true,
            },
            
            breakpoints: {
                320: {
                    slidesPerView: 1,
                    spaceBetween: 10,
                },
                640: {
                    slidesPerView: 2,
                    spaceBetween: 20,
                },
                992: {
                    slidesPerView: 3,
                    spaceBetween: 0,
                }
            },
            on: {
                init: function () { },
                slideChange: function () { }
            }
        });
    </script>
}