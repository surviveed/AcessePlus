@model AcessePlus.Modelo.Local

@{
    Layout = "_Layout";
    ViewData["Title"] = ViewBag.Local.Nome;
}

@section Scripts {
    <script src="~/site/js/pages/local.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @if (TempData["Sucesso"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Avaliação enviada com sucesso!',
                showConfirmButton: false,
                timer: 2000
            });
        </script>
    }
}

<div class="evento-container">

    <img class="evento-banner-img"
        src="@(string.IsNullOrEmpty(ViewBag.ImagemUrl) ? "/images/placeholder.png" : ViewBag.ImagemUrl)"
        alt="Imagem do local @ViewBag.Local.Nome" />


    <h1 class="evento-titulo">@ViewBag.Local.Nome</h1>

    <div class="evento-info">
        <p><strong>Endereço:</strong> @ViewBag.Local.Endereco</p>
        <p><strong>Cidade:</strong> @ViewBag.Local.Cidade?.Descricao</p>
        <p><strong>Capacidade:</strong> @ViewBag.Local.Capacidade pessoas</p>
        <p><strong>Tipo de Local:</strong> @(ViewBag.Local.TipoLocal?.Descricao ?? "Não informado")</p>
    </div>

    <button type="button" class="btn-avaliar" onclick="abrirModal('@ViewBag.Local.Nome','@ViewBag.Local.Id')"
        @(ViewBag.JaAvaliado ? "disabled" : "")>
        Avaliar
    </button>



    <div id="avaliarModal" class="modal" style="display: none;">
        <div class="modal-content">
            <span class="close" onclick="fecharModal()">&times;</span>
            <h2 class="login-title">Avaliação de <span id="nomeLocalSpan"></span></h2>

            <form action="avaliar-local" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" id="LocalId" name="LocalId" />

                <div class="input-group">
                    <label for="comentario">Comentário</label>
                    <textarea id="comentario" name="comentario" maxlength="2000" rows="5"
                        style="width: 100%;"></textarea>
                    <small id="contadorComentario">0 / 2000</small>
                </div>

                <div class="input-group">
                    <label for="tipoAcessibilidade">Tipo de Acessibilidade</label>
                    <select id="tipoAcessibilidade" name="tipoAcessibilidade" class="input" required>
                        <option value="">Selecione</option>
                        <option value="A">Auditiva</option>
                        <option value="V">Visual</option>
                        <option value="L">Locomoção</option>
                        <option value="S">Sensorial</option>
                    </select>
                </div>

                <div class="input-group">
                    <label for="tipo">Tipo</label>
                    <select id="tipo" name="tipo" class="input" required>
                        <option value="">Selecione</option>
                        <option value="P">Positiva</option>
                        <option value="N">Negativa</option>
                    </select>
                </div>

                <button type="submit" class="btn-submit">Enviar</button>
            </form>
        </div>
    </div>

</div>
