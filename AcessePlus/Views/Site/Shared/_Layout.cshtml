<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcessePlus</title>

    <link rel="stylesheet" href="~/site/css/base/variables.css" />
    <link rel="stylesheet" href="~/site/css/base/typography.css" />
    <link rel="stylesheet" href="~/site/css/pages/home.css" />
    <link rel="stylesheet" href="~/site/css/pages/local.css" />
    <link rel="stylesheet" href="~/site/css/base/components.css" />
    <link rel="shortcut icon" href="~/images/logo.ico" type="image/x-icon" />

    @if (ViewData["Title"]?.ToString() == "Login Page")
    {
        <link rel="stylesheet" href="~/site/css/pages/login.css" />
    }

    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="main-header">
        <nav class="main-header__nav">
            <a class="main-header__logo" href="/">
                <img class="main-header__logo-img" src="/images/logo.png" alt="Logo Acesse+" />
            </a>

            <div class="main-header__menu">
                <ul class="main-header__menu-list">
                    <li><a href="/#quem-somos">Quem somos</a></li>
                    <li><a asp-controller="Local" asp-action="Index">Locais</a></li>
                    <li><a asp-page="/Eventos">Eventos</a></li>
                    <li><a asp-page="/Buscar">Buscar</a></li>
                </ul>
            </div>

            <div class="btn">
                <a href="/gerenciador/login" class="button button--primary">Login</a>
                <button class="main-header__mobile-toggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <footer class="site-footer">
        <div class="site-footer__content">
            <p>© 2025 <strong>Acesse+</strong> - Todos os direitos reservados.</p>
        </div>
    </footer>

</body>
</html>