<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcessePlus</title>

    <!-- Estilos principais -->
    <link rel="stylesheet" href="~/site/css/main.css" />
    <link rel="shortcut icon" href="~/images/logo.ico" type="image/x-icon" />

    <!-- Seção de estilos adicionais (opcional) -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- Bibliotecas externas -->
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet" />
</head>

<body>
    <!-- Cabeçalho -->
    <partial name="/Views/Site/Components/Header.cshtml" />

    <!-- Corpo principal -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Rodapé -->
    <partial name="/Views/Site/Components/Footer.cshtml" />

    <!-- Scripts -->
    <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/site/js/site.js" asp-append-version="true"></script>

    <!-- Seção de scripts adicionais (opcional) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
